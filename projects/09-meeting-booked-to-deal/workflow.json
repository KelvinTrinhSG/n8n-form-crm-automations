      "id": "find-canceled-booking",
      "name": "Find Canceled Booking",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1310,
        500
      ],
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "https://docs.google.com/spreadsheets/d/PASTE_YOUR_SPREADSHEET_ID/edit",
          "mode": "url"
        },
        "sheetName": {
          "__rl": true,
          "value": "Meetings",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "invitee_uri",
              "lookupValue": "={{ $('Verify & Parse Event').first().json.invitee_uri }}"
            }
