      "id": "calendly-webhook",
      "name": "Calendly Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        70,
        400
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "calendly",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "7e1a3b5c-9d2f-4a68-8c0e-4f3a2b1c0d09",
      "notes": "invitee.created / invitee.canceled",
      "notesInFlow": true
