    {
      "id": "check-existing-booking",
      "name": "Check Existing Booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1550,
        300
      ],
      "parameters": {
        "jsCode": "// Idempotency + reschedule handling, using the \"Meetings\" sheet as memory.\n//   Same invitee already in the sheet → Calendly retried the webhook → stop (no second deal).\n//   Reschedule of a known booking → reuse its deal, do not create a new one.\n//   Otherwise → new booking.\nconst ev = $('Verify & Parse Event').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => r.invitee_uri);\n\nif (rows.some((r) => r.invitee_uri === ev.invitee_uri)) return [];\n\nconst previous = ev.old_invitee_uri && rows.find((r) => r.invitee_uri === ev.old_invitee_uri);\nif (previous && previous.deal_id) {\n  return [{\n    json: {\n      ...ev,\n      mode: 'reschedule',\n      deal_id: String(previous.deal_id),\n      hubspot_contact_id: String(previous.hubspot_contact_id || ''),\n      previous_start: previous.start_time,\n    },\n  }];\n}\nreturn [{ json: { ...ev, mode: 'new', deal_id: '', hubspot_contact_id: '', previous_start: '' } }];\n"
      },
      "notes": "Duplicate → stop · reschedule → reuse deal",
      "notesInFlow": true
    },
    {
      "id": "build-cancellation",
      "name": "Build Cancellation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1550,
        500
      ],
      "parameters": {
        "jsCode": "// A real cancellation (not a reschedule): update the sheet row, move the deal, tell the host.\n// The deal goes to CANCELED_STAGE. Many teams use \"closedlost\"; set your own \"Meeting canceled\" stage id here.\nconst CANCELED_STAGE = 'closedlost';\nconst TZ = 'America/New_York';\nconst ev = $('Verify & Parse Event').first().json;\nconst row = $input.all().map((i) => i.json).find((r) => r.invitee_uri === ev.invitee_uri) || {};\nconst esc = (v) => String(v ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst when = ev.start_time ? `${new Date(ev.start_time).toLocaleString('en-US', { timeZone: TZ, weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })} ET` : '';\nconst dealId = String(row.deal_id || '');\n\nreturn [{\n  json: {\n    invitee_uri: ev.invitee_uri,\n    status: 'Canceled',\n    email: ev.email,\n    name: ev.name,\n    company: row.company || ev.company,\n    meeting_name: ev.meeting_name,\n    start_time: ev.start_time,\n    host_email: ev.host_email,\n    hubspot_contact_id: row.hubspot_contact_id || '',\n    deal_id: dealId,\n    rescheduled_from: row.rescheduled_from || '',\n    cancel_reason: `${ev.canceled_by ? `${ev.canceled_by}: ` : ''}${ev.cancel_reason || 'no reason given'}`,\n    utm_source: row.utm_source || ev.utm_source,\n    updated_at: new Date().toISOString(),\n    has_deal: Boolean(dealId),\n    deal_update: { properties: { dealstage: CANCELED_STAGE, closed_lost_reason: `Meeting canceled: ${ev.cancel_reason || 'no reason given'}`.slice(0, 250) } },\n    email_to: ev.host_email,\n    email_subject: `❌ Canceled: ${ev.name} · ${when}`,\n    email_html: `<p><b>${esc(ev.name)}</b> &lt;${esc(ev.email)}&gt; canceled <b>${esc(ev.meeting_name)}</b> on ${when}.</p>`\n      + `<p>Reason: ${esc(ev.cancel_reason || 'no reason given')}${ev.canceled_by ? ` (by ${esc(ev.canceled_by)})` : ''}</p>`\n      + `<p>${dealId ? `Deal ${esc(dealId)} moved to \"${CANCELED_STAGE}\".` : 'No deal found for this booking (booked before the automation, or never synced).'} Worth a follow-up email to rebook.</p>`,\n  },\n}];\n"
      },
      "notes": "Status · reason · deal stage",
      "notesInFlow": true
    },
