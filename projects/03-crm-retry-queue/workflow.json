    {
      "id": "pick-due-retries",
      "name": "Pick Due Retries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        590,
        400
      ],
      "parameters": {
        "jsCode": "// Picks the queue rows that are due for another attempt.\n// A row is due when status = pending and next_retry_at is in the past.\n// At most MAX_PER_RUN rows per run, oldest first, so a long outage does not hit HubSpot's rate limit on recovery.\nconst MAX_PER_RUN = 50;\nconst now = Date.now();\n\nconst rows = $input.all()\n  .map((i) => i.json)\n  .filter((r) => r.queue_id && String(r.status).toLowerCase() === 'pending')\n  .filter((r) => !r.next_retry_at || Date.parse(r.next_retry_at) <= now)\n  .sort((a, b) => Date.parse(a.created_at) - Date.parse(b.created_at))\n  .slice(0, MAX_PER_RUN);\n\nreturn rows.map((r) => {\n  let properties = null;\n  try { properties = JSON.parse(r.payload); } catch (e) { /* sent as-is; HubSpot answers 400 → marked dead */ }\n  return {\n    json: {\n      queue_id: r.queue_id,\n      email: r.email,\n      attempts: Number(r.attempts) || 0,\n      created_at: r.created_at,\n      source_workflow: r.source_workflow,\n      request_body: {\n        inputs: [{ idProperty: 'email', id: r.email, properties: properties || { invalid_payload: r.payload } }],\n      },\n    },\n  };\n});\n"
      },
      "notes": "pending + due · max 50 · oldest first",
      "notesInFlow": true
    },
    {
      "id": "hubspot-upsert-contact",
      "name": "HubSpot · Upsert Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        870,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/batch/upsert",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request_body) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": false,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput",
      "notes": "No inner retry: the queue is the retry",
      "notesInFlow": true
    },
    {
      "id": "mark-resolved",
      "name": "Mark Resolved",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Success branch: the contact is now in HubSpot. Close the queue row.\nconst row = $('Pick Due Retries').item.json;\nconst result = ($json.results || [])[0] || {};\n\nreturn {\n  json: {\n    queue_id: row.queue_id,\n    attempts: row.attempts + 1,\n    status: 'resolved',\n    next_retry_at: '',\n    resolved_at: new Date().toISOString(),\n    hubspot_contact_id: result.id || '',\n    last_error: '',\n  },\n};\n"
      },
      "notes": "status = resolved",
      "notesInFlow": true
    },
    {
      "id": "schedule-next-retry",
      "name": "Schedule Next Retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        500
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Failure branch: decide whether to try again later or give up.\n//   400 / 404 / 422  → the data itself is wrong; retrying will never work → \"dead\" now\n//   401 / 403        → token revoked or missing scope; retry, but tell ops on the first failure\n//   429 / 5xx / network → temporary; retry with exponential backoff\n// Backoff: 15 min, 30 min, 1 h, 2 h, 4 h, then dead after MAX_ATTEMPTS.\nconst MAX_ATTEMPTS = 6;\nconst BASE_DELAY_MIN = 15;\nconst MAX_DELAY_MIN = 6 * 60;\n\nconst row = $('Pick Due Retries').item.json;\nconst err = typeof $json.error === 'object' && $json.error ? $json.error : { message: $json.error || $json.message || 'unknown error' };\nconst message = String(err.description || err.message || '').slice(0, 500);\nconst code = Number(err.httpCode || err.status || (message.match(/\\b([45]\\d\\d)\\b/) || [])[1]) || 0;\n\nconst attempts = row.attempts + 1;\nlet kind = 'temporary';\nif ([400, 404, 409, 422].includes(code)) kind = 'permanent';\nelse if ([401, 403].includes(code)) kind = 'auth';\n\nlet status = 'pending';\nif (kind === 'permanent' || attempts >= MAX_ATTEMPTS) status = 'dead';\n\nconst delayMin = Math.min(BASE_DELAY_MIN * 2 ** (attempts - 1), MAX_DELAY_MIN);\nconst jitterMs = Math.floor(Math.random() * 60 * 1000); // spread retries so they do not all fire together\nconst nextRetryAt = status === 'pending' ? new Date(Date.now() + delayMin * 60 * 1000 + jitterMs).toISOString() : '';\n\nconst escalate = status === 'dead' || (kind === 'auth' && attempts === 1);\nconst esc = (v) => String(v ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst why = {\n  permanent: 'HubSpot rejected the data. Fix the payload in the sheet, set status back to \"pending\" and it will be retried.',\n  auth: 'HubSpot refused the token. Check the private app token and its scopes (crm.objects.contacts.write) in n8n credentials.',\n  temporary: `Gave up after ${attempts} attempts.`,\n}[kind];\n\nreturn {\n  json: {\n    queue_id: row.queue_id,\n    email: row.email,\n    attempts,\n    status,\n    next_retry_at: nextRetryAt,\n    last_error_code: code ? String(code) : '',\n    last_error: message,\n    error_kind: kind,\n    escalate,\n    email_subject: `[CRM sync] ${status === 'dead' ? 'Gave up on' : 'Auth problem for'} ${row.email} (${code || 'no code'})`,\n    email_html: `<p><b>Queue ID:</b> ${esc(row.queue_id)}<br><b>Email:</b> ${esc(row.email)}<br><b>Source:</b> ${esc(row.source_workflow)}<br>`\n      + `<b>Attempts:</b> ${attempts}<br><b>Error ${code || ''}:</b> ${esc(message)}</p><p>${esc(why)}</p>`,\n  },\n};\n"
      },
      "notes": "Classify error · backoff · give up",
      "notesInFlow": true
    },
