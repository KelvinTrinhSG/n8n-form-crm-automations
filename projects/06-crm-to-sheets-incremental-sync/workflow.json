    {
      "id": "build-search-request",
      "name": "Build Search Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        590,
        400
      ],
      "parameters": {
        "jsCode": "// Builds the HubSpot search request for contacts changed since the last successful sync.\n// The cursor lives in the \"Sync State\" tab (key/value), so it is visible and can be reset by hand:\n// clear the value to re-sync the last INITIAL_DAYS days.\nconst INITIAL_DAYS = 30;\nconst KEY = 'contacts_last_modified';\n\nconst state = $input.all().map((i) => i.json).find((r) => r.key === KEY);\nconst saved = state && Date.parse(state.value);\nconst since = Number.isFinite(saved) ? saved : Date.now() - INITIAL_DAYS * 86400000;\n\nreturn [{\n  json: {\n    since_iso: new Date(since).toISOString(),\n    request_body: {\n      // GTE, not GT: two contacts can share the cursor millisecond. Re-reading one row is harmless\n      // because the sheet write is an upsert by hubspot_id.\n      filterGroups: [{ filters: [{ propertyName: 'lastmodifieddate', operator: 'GTE', value: String(since) }] }],\n      sorts: [{ propertyName: 'lastmodifieddate', direction: 'ASCENDING' }],\n      properties: ['email', 'firstname', 'lastname', 'company', 'jobtitle', 'phone', 'lifecyclestage', 'hs_lead_status',\n        'hubspot_owner_id', 'createdate', 'lastmodifieddate', 'hs_last_sales_activity_timestamp', 'num_associated_deals'],\n      limit: 100,\n    },\n  },\n}];\n"
      },
      "notes": "lastmodifieddate ≥ cursor",
      "notesInFlow": true
    },
    {
      "id": "hubspot-search-changed-contacts",
      "name": "HubSpot · Search Changed Contacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        870,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request_body) }}",
        "options": {
          "timeout": 30000,
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "body",
                    "name": "after",
                    "value": "={{ $response.body.paging?.next?.after }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.paging?.next?.after }}",
              "limitPagesFetched": true,
              "maxRequests": 50,
              "requestInterval": 250
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "stopWorkflow",
      "notes": "Paginated · 100/page · max 50 pages",
      "notesInFlow": true
    },
    {
      "id": "map-rows",
      "name": "Map Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1110,
        400
      ],
      "parameters": {
        "jsCode": "// Flattens every page returned by the paginated search into one sheet row per contact.\n// Internal HubSpot values are turned into the labels people see in HubSpot.\nconst STAGE = {\n  subscriber: 'Subscriber', lead: 'Lead', marketingqualifiedlead: 'MQL', salesqualifiedlead: 'SQL',\n  opportunity: 'Opportunity', customer: 'Customer', evangelist: 'Evangelist', other: 'Other',\n};\nconst STATUS = {\n  NEW: 'New', OPEN: 'Open', IN_PROGRESS: 'In progress', OPEN_DEAL: 'Open deal', UNQUALIFIED: 'Unqualified',\n  ATTEMPTED_TO_CONTACT: 'Attempted to contact', CONNECTED: 'Connected', BAD_TIMING: 'Bad timing',\n};\nconst SEARCH_CAP = 10000; // HubSpot search returns at most 10,000 results per query\n\nconst pages = $input.all().map((i) => i.json);\nconst total = Number(pages[0]?.total) || 0;\nconst byId = new Map(); // a contact edited during paging can appear on two pages: keep the newest\nfor (const page of pages) {\n  for (const r of page.results || []) {\n    const prev = byId.get(r.id);\n    if (!prev || Date.parse(r.properties.lastmodifieddate) >= Date.parse(prev.properties.lastmodifieddate)) byId.set(r.id, r);\n  }\n}\n\nconst now = Date.now();\nconst day = (v) => (v ? String(v).slice(0, 10) : '');\nconst rows = [...byId.values()].map(({ id, properties: p }) => {\n  const lastActivity = Date.parse(p.hs_last_sales_activity_timestamp);\n  return {\n    json: {\n      hubspot_id: String(id),\n      email: p.email || '',\n      name: [p.firstname, p.lastname].filter(Boolean).join(' '),\n      company: p.company || '',\n      job_title: p.jobtitle || '',\n      phone: p.phone || '',\n      lifecycle_stage: STAGE[p.lifecyclestage] || p.lifecyclestage || '',\n      lead_status: STATUS[p.hs_lead_status] || p.hs_lead_status || '',\n      owner_id: p.hubspot_owner_id || '',\n      deals: Number(p.num_associated_deals) || 0,\n      created: day(p.createdate),\n      last_modified: p.lastmodifieddate,\n      days_since_sales_activity: Number.isFinite(lastActivity) ? Math.floor((now - lastActivity) / 86400000) : '',\n      synced_at: new Date(now).toISOString(),\n    },\n  };\n});\n\nif (total > SEARCH_CAP) {\n  // The next run continues from the newest lastmodifieddate seen, so a big backlog is caught up over several runs.\n  rows.forEach((r) => { r.json.sync_note = `backlog: ${total} changed contacts, synced in parts`; });\n}\nreturn rows;\n"
      },
      "notes": "Flatten pages · dedupe · labels",
      "notesInFlow": true
    },
