    {
      "id": "compute-next-cursor",
      "name": "Compute Next Cursor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1630,
        400
      ],
      "parameters": {
        "jsCode": "// Runs only after the sheet write succeeded, so a failed write never moves the cursor forward\n// (the same contacts are fetched again next run instead of being skipped).\n// The cursor is the newest lastmodifieddate actually received, not \"now\": HubSpot's search index lags a few\n// seconds, and using the clock would skip contacts that were changed just before the run.\nconst rows = $('Map Rows').all().map((i) => i.json);\nconst newest = Math.max(...rows.map((r) => Date.parse(r.last_modified)).filter(Number.isFinite));\n\nreturn [{\n  json: {\n    key: 'contacts_last_modified',\n    value: new Date(newest).toISOString(),\n    rows_synced: rows.length,\n    updated_at: new Date().toISOString(),\n  },\n}];\n"
      },
      "notes": "Only after a successful write",
      "notesInFlow": true
    },
